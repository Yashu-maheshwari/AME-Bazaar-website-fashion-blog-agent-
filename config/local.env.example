# Copy this file to config/local.env and fill real values locally.
# NEVER commit config/local.env.

WORDPRESS_URL=https://amebazaar.in
WORDPRESS_USERNAME=
WORDPRESS_APPLICATION_PASSWORD=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
MOCK_GEMINI=false

# Optional image generation provider
OPENAI_API_KEY=

# Google Business Profile OAuth / publishing
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_GBP_ACCESS_TOKEN=
GOOGLE_GBP_REFRESH_TOKEN=
GOOGLE_GBP_ACCOUNT_ID=
GOOGLE_GBP_LOCATION_ID=
