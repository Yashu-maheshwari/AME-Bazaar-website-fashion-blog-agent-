# WordPress REST API Credentials
WORDPRESS_URL=https://amebazaar.in
WORDPRESS_USERNAME=your_username@example.com
WORDPRESS_APPLICATION_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Google API Credentials (OAuth Client)
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here

# Google Business Profile Credentials (Generated by scripts/gmb_auth.js)
GOOGLE_GBP_ACCOUNT_ID=
GOOGLE_GBP_LOCATION_ID=
GOOGLE_GBP_ACCESS_TOKEN=
GOOGLE_GBP_REFRESH_TOKEN=
GOOGLE_GBP_REDIRECT_URI=http://localhost:3000/callback

# Gemini API Model Keys
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest
