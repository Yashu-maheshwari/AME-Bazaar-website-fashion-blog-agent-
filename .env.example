# AME Bazaar AI Agent OS — environment template
# NEVER put real secret values in GitHub.

# Runtime / n8n
GENERIC_TIMEZONE=Asia/Kolkata
WEBHOOK_URL=https://your-n8n-host.example
N8N_ENVS_MODE=production
N8N_BLOCK_ENV_ACCESS_IN_NODE=true
N8N_ENVS_ALLOWLIST=
NODE_FUNCTION_ALLOW_BUILTIN=
NODE_FUNCTION_ALLOW_EXTERNAL=

# PostgreSQL — injected securely by hosting provider/Supabase
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Google Drive OAuth
GOOGLE_DRIVE_CLIENT_ID=your_google_drive_client_id
GOOGLE_DRIVE_CLIENT_SECRET=your_google_drive_client_secret
GOOGLE_DRIVE_REFRESH_TOKEN=your_google_drive_refresh_token

# Google Drive folders
AME_DRIVE_SOURCE_FOLDER_ID=your_source_folder_id
AME_DRIVE_DONE_FOLDER_ID=your_done_folder_id

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_UPLOAD_PRESET=your_cloudinary_upload_preset
CLOUDINARY_LOGO_PUBLIC_ID=your_cloudinary_logo_public_id

# Gemini
GEMINI_API_KEY=your_gemini_api_key

# Meta / Instagram / Facebook
META_ACCESS_TOKEN=your_meta_access_token
META_APP_SECRET=your_meta_app_secret
IG_USER_ID=your_instagram_user_id
FB_PAGE_ID=your_facebook_page_id

# Threads
THREADS_ACCESS_TOKEN=your_threads_access_token
THREADS_USER_ID=your_threads_user_id

# Google Business Profile
GBP_ACCESS_TOKEN=your_gbp_access_token
GBP_ACCOUNT_ID=your_gbp_account_id
GBP_LOCATION_ID=your_gbp_location_id
